{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SecureKit tool registry entry",
 "type": "object",
 "required": [
  "id",
  "name",
  "category",
  "summary",
  "version",
  "status",
  "runtime",
  "privacy",
  "access",
  "seo"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "name": {
   "type": "string",
   "minLength": 3
  },
  "seoTitle": {
   "type": "string"
  },
  "category": {
   "type": "string"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "summary": {
   "type": "string",
   "minLength": 40,
   "maxLength": 200
  },
  "intro": {
   "type": "string"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "faq": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "q",
     "a"
    ],
    "properties": {
     "q": {
      "type": "string"
     },
     "a": {
      "type": "string"
     }
    }
   }
  },
  "related": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "string"
   }
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "status": {
   "enum": [
    "planned",
    "beta",
    "live",
    "deprecated"
   ]
  },
  "since": {
   "type": "string"
  },
  "runtime": {
   "type": "object",
   "required": [
    "type",
    "module",
    "network"
   ],
   "properties": {
    "type": {
     "const": "client"
    },
    "module": {
     "type": "string"
    },
    "network": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "contract": {
   "type": "object"
  },
  "privacy": {
   "type": "object",
   "required": [
    "processing",
    "storesUserData",
    "sensitiveInput",
    "analytics"
   ]
  },
  "access": {
   "type": "object",
   "required": [
    "tier",
    "auth"
   ],
   "properties": {
    "tier": {
     "enum": [
      "free"
     ]
    },
    "auth": {
     "enum": [
      "none"
     ]
    }
   }
  },
  "seo": {
   "type": "object",
   "required": [
    "path"
   ]
  },
  "i18n": {
   "type": "object"
  },
  "featured": {
   "type": "boolean"
  },
  "order": {
   "type": "integer"
  }
 }
}